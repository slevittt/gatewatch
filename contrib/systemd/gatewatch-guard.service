[Unit]
Description=gatewatch guard (check, repair, alert)
After=network-online.target gatewatch-relay.service

[Service]
Type=oneshot
User=gatewatch
StateDirectory=gatewatch
ExecStart=/usr/local/bin/gatewatch -c /etc/gatewatch/gatewatch.ini guard
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/gatewatch
